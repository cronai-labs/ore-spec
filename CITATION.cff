version: "0.1.1"
date-released: "2026-10-19"
license: "CC-BY-4.0"
repository-code: "https://github.com/cronai-labs/ore-spec"
url: "https://github.com/cronai-labs/ore-spec"
keywords:
  - ore
  - markdown
  - executable notes
  - workflow
  - obsidian
  - specification
